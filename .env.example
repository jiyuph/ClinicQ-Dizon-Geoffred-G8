# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore, so it is never pushed to GitHub.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Option A: local PostgreSQL
DATABASE_URL=postgres://clinicq:your_password@localhost:5432/clinicq

# Option B: Supabase (Project > Connect > Session pooler, port 5432)
# DATABASE_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
